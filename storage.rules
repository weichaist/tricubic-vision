rules_version = '2';

// The camera app uploads videos to clips/<user uid>/ and thumbnails to
// thumbnails/<user uid>/ (the user uid is the Supabase users row, not the
// Firebase uid), then stores their download URLs. The admin portal and the
// functions open those download URLs, which carry their own access token.
service firebase.storage {
  match /b/{bucket}/o {
    match /clips/{userUid}/{fileName} {
      allow read, write: if request.auth != null;
    }
    match /thumbnails/{userUid}/{fileName} {
      allow read, write: if request.auth != null;
    }
  }
}
